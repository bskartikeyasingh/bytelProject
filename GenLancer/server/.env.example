# Server Port & Environment
PORT=3001
NODE_ENV=development

# CORS Allowed Origins (Comma-separated list of permitted frontend URLs in production)
# Example: https://genlancer.vercel.app,https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Google Gemini AI Key (Kept server-side only; never expose in frontend)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Authoritative Database Configuration (Kept server-side only)
SUPABASE_URL=https://your-project.supabase.co
# Note: Privileged service role key for authoritative backend persistence and RLS bypass
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Explicit Demo Mode Toggle (false by default in production)
# Set to 'true' to intentionally load unverified preview fixtures during development
DEMO_MODE=false
