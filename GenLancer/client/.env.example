# Centralized Frontend API Origin Configuration
# In production on Vercel, set this to your backend service URL (e.g., https://genlancer-api.onrender.com)
# In development, leave blank or set to http://localhost:3001
VITE_API_BASE_URL=http://localhost:3001
VITE_API_URL=http://localhost:3001

# Supabase Public Configuration (Public anon key only - NEVER put service role key here!)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Explicit Demo Mode Toggle (false by default)
VITE_DEMO_MODE=false
